          "400": {
            "$ref": "#/components/responses/400Error"
          },
          "429": {
            "$ref": "#/components/responses/429Error"
          }
        }
      }
    },
    "/guid/generate": {
      "post": {
        "summary": "Generate batch UUIDs/GUIDs",
        "description": "Generates a batch of UUID v4 (random), UUID v7 (time-ordered), or custom prefixed identifiers.",
