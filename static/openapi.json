    "/regex/test": {
      "post": {
        "summary": "Test a regular expression",
        "description": "Compiles a Go RE2 expression, tests it against sample text, and returns highlighted segments, matches, and capture groups. Results are bounded to the first 100 matches.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegexTestRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/RegexTestRequest"
              },
              "encoding": {
                "flags": {
                  "style": "form",
                  "explode": true
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RE2 match report",
