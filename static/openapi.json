    "/qrcode/generate": {
      "post": {
        "summary": "Generate QR Code",
        "description": "Creates a QR code as base64-encoded PNG and SVG. Only `text` is required; every other field is optional and falls back to a default, so sending just `text` reproduces the plain black-on-white code at the default size. A `preset` builds the encoded payload server-side (WiFi, vCard, MECARD, mailto, tel, SMS, geo), which is why the response echoes a resolved `payload` alongside the raw `text`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QRCodeRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/QRCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful image creation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QRCodeResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400Error"
          },
          "429": {
            "$ref": "#/components/responses/429Error"
          }
        }
      }
    },
