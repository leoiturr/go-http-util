# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Go files use tabs
[*.go]
indent_style = tab
indent_size = 4

# Web assets, config, and Markdown files
[*.{html,css,js,json,md,yaml,yml}]
indent_style = space
indent_size = 2
